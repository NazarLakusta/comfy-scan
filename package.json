{
  "name": "comfy-floor-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43127",
    "build": "next build",
    "start": "next start --port 43127",
    "lint": "eslint",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "seed:knowledge": "node scripts/seed-knowledge.mjs",
    "parse:comfy": "node scripts/parse-comfy.mjs",
    "build:pages": "BASE_PATH=/comfy-scan next build && touch out/.nojekyll",
    "sync:docs": "npm run build:pages && rm -rf docs && mkdir docs && cp -a out/. docs/ && touch docs/.nojekyll",
    "preview:static": "npx --yes serve out -l 43127"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
